---
/**
 * NetworkPattern — Subtle constellation / network graph watermark.
 * Used in the dark navy header of MAST certificates.
 *
 * Props:
 *  width   – viewBox width  (default 800)
 *  height  – viewBox height (default 300)
 *  color   – stroke/fill color (default semi-transparent white)
 *  opacity – overall opacity (default 0.12)
 *  class   – extra CSS classes
 */
interface Props {
  width?: number;
  height?: number;
  color?: string;
  opacity?: number;
  class?: string;
}
const {
  width   = 800,
  height  = 300,
  color   = "rgba(255,255,255,0.9)",
  opacity = 0.12,
  class: className = "",
} = Astro.props;

// Static node positions (percentage of w/h)
const nodes = [
  [0.05, 0.20], [0.12, 0.55], [0.20, 0.15], [0.25, 0.70],
  [0.33, 0.38], [0.40, 0.80], [0.48, 0.22], [0.52, 0.60],
  [0.60, 0.10], [0.65, 0.45], [0.70, 0.75], [0.78, 0.30],
  [0.82, 0.65], [0.90, 0.18], [0.95, 0.52], [0.15, 0.88],
  [0.38, 0.05], [0.55, 0.90], [0.72, 0.05], [0.88, 0.85],
];

// Edges connecting nearby nodes
const edges = [
  [0,2],[0,1],[1,3],[2,4],[3,4],[3,5],[4,6],[4,7],[5,7],
  [6,8],[6,9],[7,9],[8,9],[8,13],[9,11],[10,11],[10,12],
  [11,13],[12,14],[13,14],[1,15],[5,15],[6,16],[8,16],
  [7,17],[10,17],[8,18],[11,18],[12,19],[14,19],
];
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox={`0 0 ${width} ${height}`}
  class={className}
  aria-hidden="true"
  style={`opacity:${opacity};`}
>
  <!-- Connection lines -->
  {edges.map(([a, b]) => {
    const [x1p, y1p] = nodes[a];
    const [x2p, y2p] = nodes[b];
    return (
      <line
        x1={x1p * width}
        y1={y1p * height}
        x2={x2p * width}
        y2={y2p * height}
        stroke={color}
        stroke-width="0.6"
        stroke-linecap="round"
      />
    );
  })}

  <!-- Node dots -->
  {nodes.map(([xp, yp], i) => (
    <circle
      cx={xp * width}
      cy={yp * height}
      r={i % 3 === 0 ? 2.5 : 1.6}
      fill={color}
    />
  ))}
</svg>

---
/**
 * CertificateForm — sidebar form shell.
 *
 * The fields area (#form-fields-container) is empty at render time.
 * CertificateLayout's client script scans the certificate for
 * [data-field] attributes and injects the appropriate inputs
 * automatically, so each template only shows the fields it uses.
 *
 * Brand defaults are passed via data-* attributes so the client
 * script can pre-fill inputs without a server round-trip.
 */
import { brand } from "../config/brand";
---

<!-- Fields container — dynamically populated by client script -->
<div
  id="form-fields-container"
  class="flex-1 overflow-y-auto px-4 py-4 space-y-3.5"
  data-default-company={brand.defaults.companyName}
  data-default-issuer-title={brand.defaults.issuerTitle}
>
  <!-- Inputs injected here by CertificateLayout's <script> -->
  <div id="primary-fields" class="flex flex-col gap-4"></div>
  <div
    id="secondary-fields"
    class="flex flex-col gap-4 border-t border-slate-800 pt-4 mt-4"></div>
</div>

<!-- Download button — always shown -->
<div class="px-4 py-4 border-t border-slate-800 space-y-2">
  <button
    id="btn-download"
    class="w-full flex items-center justify-center gap-2
           disabled:opacity-50 disabled:cursor-not-allowed
           text-white font-semibold py-2.5 px-4 rounded-lg
           transition-colors duration-150 text-sm"
    style="background:#B39A61;"
    onmouseover="this.style.background='#957f4e'"
    onmouseout="this.style.background='#B39A61'"
    onmousedown="this.style.background='#7a6840'"
    onmouseup="this.style.background='#957f4e'"
  >
    <svg
      class="w-4 h-4 shrink-0"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
      ></path>
    </svg>
    Download PDF
  </button>
</div>

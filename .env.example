# ─────────────────────────────────────────────────────
#  Certificate App — Environment Variables
#  Copy this file to .env and fill in your values.
#  DO NOT commit .env to git.
# ─────────────────────────────────────────────────────

# The password users enter to access the certificate generator.
# Change this before deploying!
AUTH_PASSWORD=changeme123

# Optional: override the company name shown in the app UI
# (can also be set in src/config/brand.ts directly)
# BRAND_COMPANY_NAME=Acme Corp